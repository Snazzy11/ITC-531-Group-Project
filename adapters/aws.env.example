# Copy to adapters/aws.env and fill in the blanks. Keep that file out of Git.
# This example is safe to commit; don't put real credentials here.

ENVIRONMENT=cloud
PROVIDER_NAME="Amazon Web Services"
PROVIDER_REGION="us-east-2"
COMPUTE_SERVICE="Amazon Elastic Container Service"
STORAGE_SERVICE="Amazon S3"
AUTH_MODEL="Scoped IAM User"
CONTRACT_CHECKED="10/10/2026"

# --- C1: compute -------------------------------------------------------------
IMAGE_REF=                    # ECR image with a full commit SHA tag or sha256 digest
SERVICE_NAME=itc531-varne1dm   # reuse this name on each deploy
CLI=aws                      # AWS CLI command
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
ECS_CLUSTER=                  # existing ECS cluster name or ARN

# --- Part 1 deployment ------------------------------------------------------
PYTHON=python3                # change to python if needed
SERVICE_URL=                  # HTTPS address, without a path
ECS_TASK_DEFINITION=          # existing Fargate task definition (family:revision or ARN)
ECS_CONTAINER_NAME=seekr      # API container name
ECS_CONTAINER_PORT=8000
ECS_NETWORK_CONFIGURATION=    # JSON: {"awsvpcConfiguration":{"subnets":["subnet-..."],"securityGroups":["sg-..."],"assignPublicIp":"DISABLED"}}
# Wrap the JSON above in single quotes.
ECS_TARGET_GROUP_ARN=         # ip target group, port 8000, health path /health

# Set up ECR, the network and the HTTPS listener/certificate first.
# The task definition needs roles, S3 settings, and DATABASE_URL/JWT_SECRET secrets.
# The container must be able to reach the database, ECR, S3 and the secret store.
# Use Bash, AWS CLI v2 (logged in), Python 3, curl and Docker.
# After loading aws.env, build from the repo root:
#   docker build --platform linux/amd64 -t "$IMAGE_REF" .
# In the course folder, put aws.sh in adapters/ and save these three outputs:
#   set -a; source adapters/aws.env; set +a; source adapters/aws.sh
#   adapter_deploy
#   adapter_deploy
#   bash scripts/cloud-audit.sh aws

# --- C2: S3-compatible object storage ---------------------------------------
S3_ENDPOINT_URL=               # HTTPS S3 endpoint
S3_BUCKET=                     # existing bucket name
S3_REGION=us-east-2
# Leave these commented out when using an AWS profile or session.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
IAM_USER_NAME=                 # IAM user name used by adapter_verify

# --- relational --------------------------------------------------------------
DATABASE_URL=

# --- messaging (optional in modules 6-8) --------------------------------------
AMQP_URL=

# --- security ----------------------------------------------------------------
JWT_SECRET=                # generate with:  openssl rand -base64 48
JWT_ALGORITHM=HS256

# Keep the JSON in single quotes.
CORS_ORIGINS='["https://your-service-url"]'

# --- C5: cost guardrail ------------------------------------------------------
SPEND_ALERT_THRESHOLD=5     # the number you configured, for the record
