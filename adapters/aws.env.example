# Copy to adapters/aws.env and replace every value. Keep that file out of Git
# (.gitignore has adapters/*.env). Each value below describes what belongs
# there; none is a real value.

# --- provider (printed by adapter_meta) ---------------------------------------
ENVIRONMENT=<"cloud". A course template field; neither aws.sh nor the app reads it>
PROVIDER_NAME=<the provider's name, e.g. "Amazon Web Services">
PROVIDER_REGION=<the region the stack runs in, e.g. "us-east-2">
COMPUTE_SERVICE=<the service that runs the image, e.g. "Amazon Elastic Container Service">
STORAGE_SERVICE=<the object store, e.g. "Amazon S3">
AUTH_MODEL=<how the deploy authenticates, e.g. "Scoped IAM User">
CONTRACT_CHECKED=<the date you last checked the capability contract, e.g. "10/10/2026">

# --- C1: compute -------------------------------------------------------------
IMAGE_REF=<ECR image tagged with the full commit SHA or a sha256 digest; adapter_deploy refuses anything else>
SERVICE_NAME=<the ECS service name; reuse the same one on every deploy>
CLI=<the AWS CLI command, normally aws>
AWS_REGION=<the region the AWS CLI uses; same as PROVIDER_REGION>
AWS_DEFAULT_REGION=<the region the app's S3 client uses; same as PROVIDER_REGION>
ECS_CLUSTER=<an existing ECS cluster name or ARN>

# --- deployment --------------------------------------------------------------
PYTHON=<the Python 3 command, python3 or python>
SERVICE_URL=<the service's HTTPS address, without a path>
ECS_TASK_DEFINITION=<an existing Fargate task definition, family:revision or ARN>
ECS_CONTAINER_NAME=<the API container's name in that task definition>
ECS_CONTAINER_PORT=<the port the API listens on in the container: 8000, from the Dockerfile>
ECS_NETWORK_CONFIGURATION=<JSON in single quotes: {"awsvpcConfiguration":{"subnets":["subnet-..."],"securityGroups":["sg-..."],"assignPublicIp":"DISABLED"}}>
ECS_TARGET_GROUP_ARN=<an ip target group on port 8000 with health path /health>

# Set up ECR, the network and the HTTPS listener/certificate first.
# The container must be able to reach the database, the broker, ECR, S3 and the
# secret store. Use Bash, AWS CLI v2 (logged in), Python 3, curl and Docker.
# After loading aws.env, build from the repo root:
#   docker build --platform linux/amd64 -t "$IMAGE_REF" .
# Then, with the course's cloud-audit.sh copied into scripts/:
#   set -a; source adapters/aws.env; set +a; source adapters/aws.sh
#   adapter_deploy
#   bash scripts/cloud-audit.sh aws

# --- C2: S3 object storage (check_storage reads S3_ENDPOINT_URL) --------------
S3_ENDPOINT_URL=<the HTTPS S3 endpoint for the bucket's region>
S3_BUCKET=<an existing bucket name>
S3_REGION=<the bucket's region. Not read by aws.sh or the app; the app uses AWS_DEFAULT_REGION>
# Leave these commented out when the CLI uses an AWS profile or session:
# AWS_ACCESS_KEY_ID=<access key id>
# AWS_SECRET_ACCESS_KEY=<secret access key>
IAM_USER_NAME=<the IAM user that adapter_verify reports on>

# --- the app's own settings ----------------------------------------------------
# adapter_deploy doesn't pass these to the container: it keeps the environment
# and secrets of the base task definition. Set them there (secrets in Parameter
# Store); this list is the record of what the app reads. The task also needs
# S3_ENDPOINT_URL, S3_BUCKET and AWS_DEFAULT_REGION from above.
DATABASE_URL=<postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE for the database. Secret>
JWT_SECRET=<at least 32 random bytes, e.g. from: openssl rand -hex 32. Secret>
BROKER_HOST=<the host name of the RabbitMQ broker the API and workers connect to>
BROKER_USER=<the RabbitMQ user>
BROKER_PASSWORD=<that user's password. Secret>
S3_PUBLIC_ENDPOINT_URL=<leave empty on AWS: presigned URLs then use S3_ENDPOINT_URL>
ADMIN_DISPLAY_NAME=<optional: the admin account the app creates on startup, up to 50 characters>
ADMIN_PASSWORD=<optional: that admin's password, up to 72 bytes. Secret>
DEMO_USER_PASSWORD=<optional: only to fill a brand-new database with demo data; normally empty here>

# Course template fields this app doesn't read:
JWT_ALGORITHM=<not read: the app always signs with HS256 (app/tokens.py)>
CORS_ORIGINS=<not read: the app has no CORS setting>

# --- C5: cost guardrail ------------------------------------------------------
SPEND_ALERT_THRESHOLD=<the spend alert threshold you configured, for the record>
