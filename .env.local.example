RABBITMQ_TAG=3.13.7-management-alpine
BROKER_USER=User for broker service
BROKER_PASSWORD=Password for broker service
GRAFANA_USER=Grafana admin user
GRAFANA_PASSWORD=Grafana admin password
JWT_SECRET=Generate with openssl rand -hex 32

# Object storage (names must match app/ports/storage.py). For the local store in compose.yml use
# S3_ENDPOINT_URL=http://storage:9000, S3_PUBLIC_ENDPOINT_URL=http://localhost:9000, and its keys seekr / seekr-devonly.
# S3_PUBLIC_ENDPOINT_URL is the address presigned URLs are signed for; leave it empty if it is the same as S3_ENDPOINT_URL.
S3_ENDPOINT_URL=Endpoint of S3 compatible bucket, as the containers reach it.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=Name of the bucket.
AWS_DEFAULT_REGION=Region of the bucket.
AWS_ACCESS_KEY_ID=Key for bucket access.
AWS_SECRET_ACCESS_KEY=Secret key for bucket access.

# Optional: an admin account the app creates on startup (needed for admin routes; password at most 72 bytes)
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=

# Optional: fill a brand-new database with demo users, locations and items (app/demo_data.py).
# Every demo user signs in with this password (6 to 72 characters). Leave empty for no demo data.
DEMO_USER_PASSWORD=
