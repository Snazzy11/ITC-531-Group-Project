# Copy to store.env. These values point at the local RustFS `storage` service
# in compose.yml. For a provider: use credentials scoped to the bucket, set the
# real bucket and region, set S3_ENDPOINT_URL to the provider's S3 endpoint,
# and delete S3_PUBLIC_ENDPOINT_URL. Every setting is described in
# milestones/milestone4/adapters/local.env.example.
AWS_ACCESS_KEY_ID=seekr
AWS_SECRET_ACCESS_KEY=seekr-devonly
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=seekr-images

# Used by the app and worker inside Docker.
S3_ENDPOINT_URL=http://storage:9000
# Used to sign the upload/download URLs handed to clients, so it must be
# reachable from the client. Change the port if you set S3_PORT.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
