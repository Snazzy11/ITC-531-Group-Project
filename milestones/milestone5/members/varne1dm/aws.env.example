# Adapter configuration template — copy to adapters/PROVIDER.env
#
# This file is read by `set -a; source <file>` in the course scripts, so it must
# be valid shell. That means NO angle brackets in values: bash reads `<` as a
# redirect and aborts, silently leaving every variable below it unset.
# Placeholders here are therefore written as comments, not as <placeholders>.
#
# THIS FILE IS GITIGNORED. Never commit it. Never paste it into a discussion
# post, a screenshot, or an assignment submission. If you think you have leaked
# a credential, revoke it first and ask questions second — see
# _shared/credential-incident.md.
#
# Submit adapters/<yourprovider>.env.example instead: the same file with every
# value replaced by a description of what goes there.

ENVIRONMENT=cloud
PROVIDER_NAME="Amazon Web Services"
PROVIDER_REGION="us-east-2"
COMPUTE_SERVICE="Amazon Elastic Container Service"
STORAGE_SERVICE="Amazon S3"
AUTH_MODEL="Scoped IAM User"
CONTRACT_CHECKED="10/10/2026"

# --- C1: compute -------------------------------------------------------------
IMAGE_REF=Container image                 # registry/namespace/itc531-app:GIT_SHA  -- an immutable tag, never a moving one
SERVICE_NAME=itc531-varne1dm            # itc531-yourcmuid  (lowercase, no angle brackets)
CLI=aws                       # the provider CLI binary your adapter shells out to
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
ECS_CLUSTER=Cluster name

# --- C2: S3-compatible object storage ---------------------------------------
S3_ENDPOINT_URL=S3 object storage URL
S3_BUCKET=S3 Bucket Name
S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=Access key         # these two names are the S3 API convention, not a
AWS_SECRET_ACCESS_KEY=Secret access key     # statement about which company you are using
IAM_USER_NAME=User name for scoped IAM user 

# --- relational --------------------------------------------------------------
DATABASE_URL=

# --- messaging (optional in modules 6-8) --------------------------------------
AMQP_URL=

# --- security ----------------------------------------------------------------
JWT_SECRET=                # generate with:  openssl rand -base64 48
JWT_ALGORITHM=HS256

# Keep the single quotes. This file is read by `set -a; source`, and bash removes
# unquoted double quotes, which would turn a JSON list into [https://...] — not
# JSON. The app then refuses to start and the error names cors_origins, not this
# file. Compose strips the outer single quotes, so the same line works in both.
CORS_ORIGINS='["https://your-service-url"]'

# --- C5: cost guardrail ------------------------------------------------------
SPEND_ALERT_THRESHOLD=5     # the number you configured, for the record
