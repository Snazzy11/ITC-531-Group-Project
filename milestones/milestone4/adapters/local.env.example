# The store adapter: every setting the storage port reads. Copy to store.env at
# the repository root and fill in each value. Nothing here is a real value.

# The access key ID for the store. Locally: the RUSTFS_ACCESS_KEY set on the
# storage service in compose.yml. With a provider: a key scoped to this one bucket.
AWS_ACCESS_KEY_ID=<access key id for the store>

# The secret that goes with that key. Locally: RUSTFS_SECRET_KEY in compose.yml.
# Never commit the real one.
AWS_SECRET_ACCESS_KEY=<secret access key for the store>

# The bucket's region. The local store accepts any region name.
AWS_DEFAULT_REGION=<region the bucket lives in>

# The bucket name. The app creates it on startup if it does not exist.
S3_BUCKET=<bucket name>

# Where the app and image worker reach the store. Inside compose this is the
# storage service's name and port; with a provider, its S3 endpoint URL.
S3_ENDPOINT_URL=<S3 endpoint as seen from inside the containers>

# The address presigned URLs are signed for. It must be reachable from the
# client (a browser or curl on the host), and the host name is part of the
# signature. Leave unset when it is the same as S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=<S3 endpoint as seen from the client>
